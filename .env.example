# ==============================================================================
# Velavan Catering Services – Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# Do NOT commit `.env.local` or any production secrets to GitHub.
# Configure these variables in the Netlify Dashboard under:
# Site configuration > Environment variables

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT CONFIGURATION (Publicly Accessible in Browser)
# ------------------------------------------------------------------------------
# These variables carry the `NEXT_PUBLIC_` prefix and are embedded into the client
# bundle during build. They are safe for public consumption and governed by Supabase
# Row-Level Security (RLS) policies.
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. SUPABASE SERVICE-ROLE KEY (STRICTLY SERVER-ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# This elevated administrative key bypasses Row-Level Security (RLS).
# Used exclusively on the server in:
# - API route: app/api/admin/reset-password/route.ts (server-side password update)
# - API route: app/api/admin/upload/route.ts (authenticated storage uploads & deletions)
# - Server client: lib/supabase-server.ts (CMS operations)
# NEVER prefix with NEXT_PUBLIC_ or import into client components.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. SITE URL CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL of the website. Used by the server to determine origin, generate
# password recovery redirects, and enforce Secure cookie flags in production.
# Local Development: http://localhost:3000
# Production:        https://velavan-catering.netlify.app (or custom domain https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. OPTIONAL / BOOTSTRAP CONFIGURATION
# ------------------------------------------------------------------------------
# One-time bootstrap secret used to initialize admin roles via
# POST /api/admin/bootstrap-role with x-admin-bootstrap-secret header.
# Keep unset in production to disable the bootstrap endpoint.
# ADMIN_BOOTSTRAP_SECRET=your-random-bootstrap-secret
